{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "preLaunch": ["dev.sixik.aeupgrade.platform.UniGuiFabricCompatibility"],
    "main": ["dev.sixik.aeupgrade.platform.FabricEntrypoint"],
    "client": ["dev.sixik.aeupgrade.platform.FabricClientEntrypoint"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "ae2": "=${ae2_fabric_version}",
    "unigui": ">=${unigui_version}"
  },
  "suggests": {
    "jade": "*"
  }
}
